{
  "version": 3,
  "framework": {
    "name": "nuxt",
    "version": "4.7.0"
  },
  "overrides": {},
  "routes": [
    {
      "src": "^/_nuxt(?:/(.*))?$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/_nuxt/builds(?:/(.*))?$",
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "continue": true
    },
    {
      "src": "^/_nuxt/builds/meta(?:/(.*))?$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/_nuxt/builds/meta/(.*)$",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "^/_nuxt/builds/(.*)$",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "^/_nuxt/(.*)$",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/_nuxt/builds/meta/(.*)$",
      "status": 404,
      "headers": {
        "cache-control": "no-store"
      },
      "continue": false
    },
    {
      "src": "^/_nuxt/builds/(.*)$",
      "status": 404,
      "headers": {
        "cache-control": "no-store"
      },
      "continue": false
    },
    {
      "src": "^/_nuxt/(.*)$",
      "status": 404,
      "headers": {
        "cache-control": "no-store"
      },
      "continue": false
    },
    {
      "src": "^(?<__isr_route>/__nuxt_error/?)$",
      "dest": "/__fallback"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}